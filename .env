# ─────────────────────────────────────────────────────────────────────────────
# .env.example
# Driver Booking Bot — Environment Variable Reference
#
# HOW TO USE:
#   cp .env.example .env
#   Fill in every value below, then start the server.
#
# ⚠️  NEVER commit your real .env file to version control.
#     This file (.env.example) is safe to commit — it contains no secrets.
# ─────────────────────────────────────────────────────────────────────────────


# ─────────────────────────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────────────────────────

# Port the Express HTTP server listens on.
PORT=3000

# Runtime environment. Controls log format (morgan) and other env-aware logic.
# Values: development | production
NODE_ENV=development


# ─────────────────────────────────────────────────────────────────────────────
# WHATSAPP CLOUD API
# Meta Developer Portal → Your App → WhatsApp → API Setup
# https://developers.facebook.com/apps/
# ─────────────────────────────────────────────────────────────────────────────

# Permanent access token (or a system user token for production).
# Found under: WhatsApp → API Setup → "Temporary access token" (dev)
# For production: Business Settings → System Users → Generate Token
WHATSAPP_ACCESS_TOKEN=

# The numeric Phone Number ID of your WhatsApp Business sender number.
# Found under: WhatsApp → API Setup → "Phone Number ID"
WHATSAPP_PHONE_NUMBER_ID=

# A secret string YOU choose when registering the webhook in Meta's dashboard.
# Meta sends this back during webhook verification — must match exactly.
# Use a long random string, e.g.: openssl rand -hex 32
WHATSAPP_VERIFY_TOKEN=

# WhatsApp Cloud API version to use. Update when Meta releases new versions.
WHATSAPP_API_VERSION=v19.0


# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE CALENDAR API
# Google Cloud Console → IAM & Admin → Service Accounts
# https://console.cloud.google.com/
#
# Steps to obtain credentials:
#   1. Create a Google Cloud project (or use an existing one).
#   2. Enable the "Google Calendar API" for the project.
#   3. Create a Service Account under IAM & Admin → Service Accounts.
#   4. Generate a JSON key for the service account → download it.
#   5. Share your Google Calendar with the service account email
#      (give it "Make changes to events" permission).
#   6. Copy the values below from the downloaded JSON key file.
# ─────────────────────────────────────────────────────────────────────────────

# Service account email address.
# From the JSON key file: "client_email"
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# RSA private key for the service account.
# From the JSON key file: "private_key"
# ⚠️  The key contains literal \n newlines — keep them exactly as-is.
#     Wrap the entire value in double quotes if your shell requires it.
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"

# The Google Calendar ID where driver bookings are stored.
# For the driver's primary calendar this is usually their Gmail address.
# For a dedicated calendar: Google Calendar → Settings → Calendar ID
GOOGLE_CALENDAR_ID=driver@example.com


# ─────────────────────────────────────────────────────────────────────────────
# DRIVER / BUSINESS RULES
# These control what counts as a "bookable" slot during availability checks.
# ─────────────────────────────────────────────────────────────────────────────

# IANA timezone name for the driver's working hours.
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
DRIVER_TIMEZONE=Asia/Kolkata

# Start and end of the driver's working day (24-hour HH:mm format).
DRIVER_WORK_START=08:00
DRIVER_WORK_END=20:00

# Minimum bookable slot duration in minutes.
# Slots shorter than this are not offered as available.
DRIVER_MIN_SLOT_MINUTES=60
