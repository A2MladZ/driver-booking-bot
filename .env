# ─────────────────────────────────────────────────────────────────────────────
# .env.example (DEV READY VERSION)
# Driver Booking Bot — Environment Variable Reference
# ─────────────────────────────────────────────────────────────────────────────


# ─────────────────────────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=development


# ─────────────────────────────────────────────────────────────────────────────
# WHATSAPP CLOUD API (DUMMY VALUES FOR DEV ONLY)
# ─────────────────────────────────────────────────────────────────────────────

WHATSAPP_ACCESS_TOKEN=dummy_whatsapp_token_1234567890
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=dummy_verify_token_abc12345
WHATSAPP_API_VERSION=v19.0


# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE CALENDAR API (DUMMY VALUES FOR DEV ONLY)
# ─────────────────────────────────────────────────────────────────────────────

GOOGLE_SERVICE_ACCOUNT_EMAIL=dummy-service-account@demo-project.iam.gserviceaccount.com

GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nDUMMY_PRIVATE_KEY_FOR_DEVELOPMENT_ONLY\nLINE_2\nLINE_3\n-----END RSA PRIVATE KEY-----\n"

GOOGLE_CALENDAR_ID=driver.demo@gmail.com


# ─────────────────────────────────────────────────────────────────────────────
# DRIVER / BUSINESS RULES
# ─────────────────────────────────────────────────────────────────────────────

DRIVER_TIMEZONE=Asia/Kolkata
DRIVER_WORK_START=08:00
DRIVER_WORK_END=20:00
DRIVER_MIN_SLOT_MINUTES=60


# ─────────────────────────────────────────────────────────────────────────────
# MICROSOFT SQL SERVER
# ─────────────────────────────────────────────────────────────────────────────

SQL_SERVER=localhost
SQL_DATABASE=DriverBooking
SQL_USER=driverbot_admin
SQL_PASSWORD=Akrk@1234
SQL_PORT=1433

SQL_ENCRYPT=false
SQL_TRUST_CERT=true